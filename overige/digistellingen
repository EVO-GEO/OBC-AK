<!DOCTYPE html>
<html lang="nl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Digitale Dilemma's — Klassendiscussie</title>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,400;9..144,500&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #f6f3ee;
    --surface: #ffffff;
    --surface-warm: #faf8f4;
    --border: #e4dfd6;
    --border-hover: #cdc5b8;
    --text: #3d3832;
    --text-dim: #918778;
    --text-light: #b5aa9a;
    --accent: #7a6a52;
    --accent-warm: #a08b6e;
    --accent-soft: rgba(122,106,82,0.08);
    --slider-track: #e8e2d8;
    --slider-fill: #a08b6e;
    --font-display: 'Fraunces', serif;
    --font-body: 'DM Sans', sans-serif;
  }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    background: var(--bg);
    color: var(--text);
    font-family: var(--font-body);
    font-weight: 300;
    min-height: 100vh;
    overflow-x: hidden;
  }
  body::before {
    content: '';
    position: fixed;
    inset: 0;
    background:
      radial-gradient(ellipse 70% 50% at 15% 5%, rgba(196,169,122,0.07) 0%, transparent 60%),
      radial-gradient(ellipse 50% 70% at 85% 95%, rgba(160,139,110,0.05) 0%, transparent 60%);
    pointer-events: none;
    z-index: 0;
  }
  header {
    position: relative;
    z-index: 1;
    padding: 3rem 2rem 2rem;
    text-align: center;
  }
  header h1 {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: 2.2rem;
    color: var(--text);
    margin-bottom: 0.5rem;
    letter-spacing: -0.01em;
  }
  header p {
    font-size: 0.8rem;
    color: var(--text-dim);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    font-weight: 400;
  }
  .header-line {
    width: 40px;
    height: 1px;
    background: var(--border-hover);
    margin: 1.2rem auto 0;
  }
  .tabs-container {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(246,243,238,0.92);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--border);
  }
  .tabs-scroll {
    display: flex;
    overflow-x: auto;
    scrollbar-width: none;
    padding: 0 1rem;
    max-width: 900px;
    margin: 0 auto;
  }
  .tabs-scroll::-webkit-scrollbar { display: none; }
  .tab-btn {
    flex-shrink: 0;
    padding: 0.9rem 1.1rem;
    background: none;
    border: none;
    color: var(--text-light);
    font-family: var(--font-body);
    font-size: 0.72rem;
    font-weight: 400;
    letter-spacing: 0.06em;
    cursor: pointer;
    position: relative;
    transition: color 0.3s;
    white-space: nowrap;
  }
  .tab-btn::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 0;
    height: 1.5px;
    background: var(--accent);
    transition: width 0.4s cubic-bezier(0.4,0,0.2,1);
  }
  .tab-btn:hover { color: var(--text-dim); }
  .tab-btn.active { color: var(--accent); font-weight: 500; }
  .tab-btn.active::after { width: 70%; }
  .tab-number {
    display: inline-block;
    margin-right: 0.35em;
    font-size: 0.65rem;
    opacity: 0.5;
  }
  main {
    position: relative;
    z-index: 1;
    max-width: 680px;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 5rem;
  }
  .panel {
    display: none;
    animation: fadeIn 0.45s ease-out;
  }
  .panel.active { display: block; }
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .panel-header { margin-bottom: 2.5rem; }
  .panel-counter {
    font-size: 0.65rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text-light);
    margin-bottom: 1rem;
    font-weight: 400;
  }
  .stelling-text {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 300;
    line-height: 1.75;
    color: var(--text);
    padding-left: 1.2rem;
    border-left: 2px solid var(--border-hover);
  }
  .sliders-section {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }
  .slider-group {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 1.1rem 1.4rem 1.3rem;
    transition: border-color 0.3s, box-shadow 0.3s;
  }
  .slider-group:hover {
    border-color: var(--border-hover);
    box-shadow: 0 2px 16px rgba(122,106,82,0.06);
  }
  .slider-label-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.7rem;
  }
  .slider-label {
    font-size: 0.78rem;
    font-weight: 400;
    color: var(--text);
  }
  .slider-value {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--accent);
    min-width: 1.8em;
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  .slider-ends {
    display: flex;
    justify-content: space-between;
    margin-top: 0.45rem;
  }
  .slider-end {
    font-size: 0.62rem;
    color: var(--text-light);
    letter-spacing: 0.03em;
  }
  input[type="range"] {
    -webkit-appearance: none;
    appearance: none;
    width: 100%;
    height: 4px;
    background: var(--slider-track);
    border-radius: 99px;
    outline: none;
    cursor: pointer;
  }
  input[type="range"]::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 20px;
    height: 20px;
    background: var(--surface);
    border: 2px solid var(--accent-warm);
    border-radius: 50%;
    cursor: pointer;
    transition: box-shadow 0.2s, transform 0.2s;
    box-shadow: 0 1px 4px rgba(0,0,0,0.08);
  }
  input[type="range"]::-moz-range-thumb {
    width: 20px;
    height: 20px;
    background: var(--surface);
    border: 2px solid var(--accent-warm);
    border-radius: 50%;
    cursor: pointer;
    box-shadow: 0 1px 4px rgba(0,0,0,0.08);
  }
  input[type="range"]:hover::-webkit-slider-thumb {
    box-shadow: 0 1px 8px rgba(122,106,82,0.2);
    transform: scale(1.1);
  }
  input[type="range"]:active::-webkit-slider-thumb {
    background: var(--accent-warm);
    border-color: var(--accent);
  }
  input[type="range"].filled {
    background: linear-gradient(90deg,
      var(--slider-fill) 0%,
      var(--slider-fill) var(--fill),
      var(--slider-track) var(--fill),
      var(--slider-track) 100%
    );
    border-radius: 99px;
  }
  .discussion-box {
    margin-top: 2rem;
    padding: 1.3rem 1.5rem;
    background: var(--surface-warm);
    border-radius: 10px;
    border: 1px solid var(--border);
  }
  .discussion-box h3 {
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: 400;
    color: var(--accent);
    margin-bottom: 0.9rem;
  }
  .discussion-box ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }
  .discussion-box li {
    font-size: 0.8rem;
    color: var(--text-dim);
    padding-left: 1rem;
    position: relative;
    line-height: 1.55;
  }
  .discussion-box li::before {
    content: '\00B7';
    position: absolute;
    left: 0;
    color: var(--accent-warm);
    font-weight: 500;
    font-size: 1.4em;
    line-height: 1.1;
  }
  .reset-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 1.3rem;
    padding: 0.45rem 0.9rem;
    background: none;
    border: 1px solid var(--border);
    color: var(--text-light);
    font-family: var(--font-body);
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    cursor: pointer;
    border-radius: 6px;
    transition: all 0.3s;
  }
  .reset-btn:hover {
    border-color: var(--border-hover);
    color: var(--text-dim);
  }
  .nav-arrows {
    display: flex;
    justify-content: space-between;
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }
  .nav-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.55rem 1.1rem;
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--text-dim);
    font-family: var(--font-body);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    cursor: pointer;
    border-radius: 8px;
    transition: all 0.3s;
  }
  .nav-btn:hover {
    border-color: var(--border-hover);
    color: var(--accent);
    box-shadow: 0 2px 10px rgba(122,106,82,0.08);
  }
  .nav-btn:disabled {
    opacity: 0.25;
    cursor: not-allowed;
    box-shadow: none;
  }
  .progress-dots {
    position: fixed;
    bottom: 1.2rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 6px;
    z-index: 100;
    background: rgba(246,243,238,0.9);
    backdrop-filter: blur(8px);
    padding: 0.5rem 0.8rem;
    border-radius: 20px;
    border: 1px solid var(--border);
  }
  .progress-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--border);
    cursor: pointer;
    transition: all 0.3s;
  }
  .progress-dot:hover { background: var(--border-hover); }
  .progress-dot.active {
    background: var(--accent-warm);
    width: 18px;
    border-radius: 3px;
  }
  @media (max-width: 640px) {
    header h1 { font-size: 1.6rem; }
    header { padding: 2rem 1.5rem 1.5rem; }
    .stelling-text { font-size: 1.1rem; }
    main { padding: 1.8rem 1rem 5rem; }
    .slider-group { padding: 1rem 1.1rem 1.1rem; }
  }
</style>
</head>
<body>
<header>
  <h1>Digitale Dilemma's</h1>
  <p>Klassendiscussie</p>
  <div class="header-line"></div>
</header>
<nav class="tabs-container">
  <div class="tabs-scroll" id="tabsScroll"></div>
</nav>
<main id="mainContent"></main>
<div class="progress-dots" id="progressDots"></div>

<script>
const stellingen = [
  { id: "slaaptekort", label: "Slaaptekort", text: "Het is de verantwoordelijkheid van je ouders (en niet van jezelf) dat je telefoon om 22:00 uur uit gaat.", sliders: [{ label: "Eens / Oneens", min: "Helemaal oneens", max: "Helemaal eens" }, { label: "Eigen verantwoordelijkheid vs. ouderlijke rol", min: "Kind beslist zelf", max: "Ouders beslissen" }, { label: "Haalbaarheid in de praktijk", min: "Onrealistisch", max: "Heel haalbaar" }, { label: "Effect op welzijn", min: "Geen effect", max: "Groot effect" }], prompts: ["Wie is uiteindelijk verantwoordelijk voor jouw gezondheid?", "Wat zou jij doen als je ouders je telefoon om 22:00 afpakken?", "Ken je iemand die slaapproblemen heeft door telefoongebruik?"] },
  { id: "ai-echtheid", label: "AI-Echtheid", text: "Als een video van een influencer of politicus er echt uitziet, mag je ervan uitgaan dat het waar is totdat iemand het tegendeel bewijst.", sliders: [{ label: "Eens / Oneens", min: "Helemaal oneens", max: "Helemaal eens" }, { label: "Vertrouwen in beeldmateriaal", min: "Altijd wantrouwen", max: "Altijd vertrouwen" }, { label: "Wie draagt de bewijslast?", min: "De kijker checkt", max: "De maker bewijst" }, { label: "Gevaar voor de samenleving", min: "Minimaal risico", max: "Groot gevaar" }], prompts: ["Hoe kun je controleren of een video echt of nep is?", "Wat als een deepfake-video verkiezingen beïnvloedt?", "Moet je alles wantrouwen wat je online ziet?"] },
  { id: "wachtwoorden", label: "Wachtwoorden", text: "Het is een teken van echte vriendschap als je elkaars wachtwoord of toegangscode weet 'voor het geval dat'.", sliders: [{ label: "Eens / Oneens", min: "Helemaal oneens", max: "Helemaal eens" }, { label: "Vertrouwen vs. privacy", min: "Privacy gaat voor", max: "Vertrouwen gaat voor" }, { label: "Risico op misbruik", min: "Klein risico", max: "Groot risico" }, { label: "Sociale druk om te delen", min: "Geen druk", max: "Veel druk" }], prompts: ["Wat kan er misgaan als een vriendschap stuk loopt?", "Is 'nee' zeggen een teken van wantrouwen?", "Welke informatie deel je wél en welke niet?"] },
  { id: "groepsapp", label: "Groepsapp", text: "Iemand uit een klassenapp verwijderen zonder overleg is een vorm van digitaal pesten, ook als diegene irritant deed.", sliders: [{ label: "Eens / Oneens", min: "Helemaal oneens", max: "Helemaal eens" }, { label: "Pesten vs. groepsbesluit", min: "Logisch besluit", max: "Pesten" }, { label: "Impact op het slachtoffer", min: "Niet zo erg", max: "Zeer pijnlijk" }, { label: "Moeten er regels zijn voor groepsapps?", min: "Nee, niet nodig", max: "Ja, absoluut" }], prompts: ["Hoe voelt het om buitengesloten te worden?", "Is er verschil tussen offline en online buitensluiten?", "Wie beslist er in een groepsapp?"] },
  { id: "focus", label: "Focus", text: "Je kunt prima geconcentreerd huiswerk maken terwijl je telefoon naast je ligt en af en toe oplicht met meldingen.", sliders: [{ label: "Eens / Oneens", min: "Helemaal oneens", max: "Helemaal eens" }, { label: "Zelfkennis: hoe goed ken je jezelf?", min: "Ik overschat mezelf", max: "Ik ken mezelf goed" }, { label: "Effect op studieresultaten", min: "Geen invloed", max: "Grote invloed" }, { label: "Bereidheid om telefoon weg te leggen", min: "Nooit", max: "Altijd tijdens huiswerk" }], prompts: ["Hoe lang kun jij je concentreren zonder je telefoon te checken?", "Wat doet alleen al het zién van een melding met je aandacht?", "Welke trucs gebruik je om gefocust te blijven?"] },
  { id: "privacy-school", label: "Privacy", text: "Je mag op school alles en iedereen filmen, zolang je de beelden maar alleen in je eigen filmrol bewaart en niet online zet.", sliders: [{ label: "Eens / Oneens", min: "Helemaal oneens", max: "Helemaal eens" }, { label: "Recht op privacy vs. recht op filmen", min: "Privacy gaat voor", max: "Filmen mag altijd" }, { label: "Vertrouwen dat beelden privé blijven", min: "Nul vertrouwen", max: "Volledig vertrouwen" }, { label: "Behoefte aan schoolregels hierover", min: "Niet nodig", max: "Hard nodig" }], prompts: ["Hoe zou jij je voelen als iemand jou filmt zonder te vragen?", "Kun je garanderen dat privébeelden ook privé blijven?", "Wat zegt de wet eigenlijk over filmen op school?"] },
  { id: "sluikreclame", label: "Sluikreclame", text: "Ik herken het altijd direct als een influencer betaald krijgt om een product te promoten, ook zonder #ad.", sliders: [{ label: "Eens / Oneens", min: "Helemaal oneens", max: "Helemaal eens" }, { label: "Hoe goed herken je reclame echt?", min: "Vaak niet", max: "Altijd" }, { label: "Verantwoordelijkheid influencer", min: "Niet hun probleem", max: "Altijd eerlijk zijn" }, { label: "Invloed op jouw koopgedrag", min: "Geen invloed", max: "Grote invloed" }], prompts: ["Noem een voorbeeld van sluikreclame die je herkende — of juist niet.", "Moet het strafbaar zijn om reclame niet te vermelden?", "Waarom werkt influencer-marketing zo goed bij jongeren?"] },
  { id: "like-druk", label: "Like-druk", text: "Als een foto na een uur nog bijna geen likes heeft, is het logisch dat je hem verwijdert omdat de foto blijkbaar niet goed genoeg is.", sliders: [{ label: "Eens / Oneens", min: "Helemaal oneens", max: "Helemaal eens" }, { label: "Zelfwaarde gekoppeld aan likes", min: "Helemaal niet", max: "Heel sterk" }, { label: "Sociale druk om populair te lijken", min: "Geen druk", max: "Enorme druk" }, { label: "Hoe erg is het om een foto te verwijderen?", min: "Helemaal niet erg", max: "Teken van een probleem" }], prompts: ["Heb je zelf weleens een foto verwijderd om te weinig likes?", "Wat bepaalt of een foto 'goed genoeg' is?", "Hoe zou social media eruitzien zonder likes?"] },
  { id: "ghosting", label: "Ghosting", text: "Als je ziet dat iemand je bericht gelezen heeft (blauwe vinkjes) maar niet reageert, heb je het recht om boos te worden.", sliders: [{ label: "Eens / Oneens", min: "Helemaal oneens", max: "Helemaal eens" }, { label: "Recht op een reactie", min: "Nee, nooit verplicht", max: "Ja, altijd reageren" }, { label: "Hoe kwetsend is ghosting?", min: "Niet zo erg", max: "Zeer kwetsend" }, { label: "Eigen schuld bij boosheid?", min: "Boosheid is logisch", max: "Jij moet loslaten" }], prompts: ["Zijn er goede redenen om niet meteen te reageren?", "Wat is het verschil tussen ghosting en even geen zin hebben?", "Zet jij je leesbevestigingen aan of uit? Waarom?"] },
  { id: "ai-huiswerk", label: "AI-Huiswerk", text: "Het is niet erg om ChatGPT je hele boekverslag te laten schrijven, zolang je de tekst maar een beetje aanpast naar je eigen woorden.", sliders: [{ label: "Eens / Oneens", min: "Helemaal oneens", max: "Helemaal eens" }, { label: "Fraude of slim hulpmiddel?", min: "Gewoon fraude", max: "Slim hulpmiddel" }, { label: "Leereffect", min: "Je leert niets", max: "Je leert genoeg" }, { label: "Waar ligt de grens van AI-gebruik?", min: "Nooit voor schoolwerk", max: "Altijd toegestaan" }], prompts: ["Is het verschil groot tussen AI-gebruik en overschrijven van internet?", "Hoe zou een leraar AI-fraude moeten aanpakken?", "Wanneer is AI-hulp wél oké en wanneer niet?"] },
  { id: "ongewenste-tags", label: "Tags", text: "Als een vriend een lelijke foto van jou post waar hij zelf wel goed op staat, moet hij die direct verwijderen als jij dat vraagt.", sliders: [{ label: "Eens / Oneens", min: "Helemaal oneens", max: "Helemaal eens" }, { label: "Wie beslist over een gedeelde foto?", min: "De poster beslist", max: "De afgebeelde beslist" }, { label: "Snelheid van verwijderen", min: "Mag even duren", max: "Moet direct" }, { label: "Schade aan de vriendschap", min: "Geen issue", max: "Kan vriendschap breken" }], prompts: ["Moet je altijd toestemming vragen vóór het posten?", "Wat als je vriend weigert de foto te verwijderen?", "Hoe belangrijk is het hoe je eruitziet op foto's van anderen?"] },
  { id: "filter-perfectie", label: "Filters", text: "Het gebruik van beauty-filters op TikTok en Snapchat zorgt ervoor dat we onzekerder worden over ons echte uiterlijk.", sliders: [{ label: "Eens / Oneens", min: "Helemaal oneens", max: "Helemaal eens" }, { label: "Invloed op zelfbeeld", min: "Geen invloed", max: "Zeer schadelijk" }, { label: "Moeten platforms filters beperken?", min: "Nee, eigen keuze", max: "Ja, zeker bij minderjarigen" }, { label: "Gebruik je zelf filters?", min: "Nooit", max: "Bijna altijd" }], prompts: ["Merk je verschil in hoe je jezelf ziet na filtergebruik?", "Is een filter anders dan make-up?", "Moeten filters een waarschuwingslabel krijgen?"] }
];

let currentTab = 0;
const STORAGE_KEY = 'digi_dilemmas_data'; // Unieke sleutel voor opslag
const tabsScroll = document.getElementById('tabsScroll');
const progressDots = document.getElementById('progressDots');
const mainContent = document.getElementById('mainContent');

// 1. Initialiseer de interface
stellingen.forEach((s, i) => {
  const btn = document.createElement('button');
  btn.className = 'tab-btn' + (i === 0 ? ' active' : '');
  btn.innerHTML = `<span class="tab-number">${i + 1}.</span>${s.label}`;
  btn.onclick = () => switchTab(i);
  tabsScroll.appendChild(btn);

  const dot = document.createElement('div');
  dot.className = 'progress-dot' + (i === 0 ? ' active' : '');
  dot.onclick = () => switchTab(i);
  progressDots.appendChild(dot);

  const panel = document.createElement('div');
  panel.className = 'panel' + (i === 0 ? ' active' : '');
  panel.id = `panel-${s.id}`;
  panel.innerHTML = `
    <div class="panel-header">
      <div class="panel-counter">Stelling ${i + 1} van ${stellingen.length}</div>
      <div class="stelling-text">${s.text}</div>
    </div>
    <div class="sliders-section">
      ${s.sliders.map((sl, si) => `
        <div class="slider-group">
          <div class="slider-label-row">
            <span class="slider-label">${sl.label}</span>
            <span class="slider-value" id="val-${s.id}-${si}">5</span>
          </div>
          <input type="range" min="0" max="10" value="5" class="filled" data-id="${s.id}" data-idx="${si}" style="--fill:50%" oninput="updateSlider(this,'${s.id}',${si})" />
          <div class="slider-ends">
            <span class="slider-end">${sl.min}</span>
            <span class="slider-end">${sl.max}</span>
          </div>
        </div>`).join('')}
    </div>
    <div class="discussion-box">
      <h3>Gespreksstarters</h3>
      <ul>${s.prompts.map(p => `<li>${p}</li>`).join('')}</ul>
    </div>
    <button class="reset-btn" onclick="resetSliders('${s.id}',${s.sliders.length})">↺ Reset sliders</button>
    <div class="nav-arrows">
      <button class="nav-btn" onclick="switchTab(${i-1})" ${i===0?'disabled':''}>← Vorige</button>
      <button class="nav-btn" onclick="switchTab(${i+1})" ${i===stellingen.length-1?'disabled':''}>Volgende →</button>
    </div>`;
  mainContent.appendChild(panel);
});

// 2. Local Storage Functies
function saveState() {
  const data = {};
  document.querySelectorAll('input[type="range"]').forEach(input => {
    const id = input.dataset.id;
    const idx = input.dataset.idx;
    if (!data[id]) data[id] = {};
    data[id][idx] = input.value;
  });
  localStorage.setItem(STORAGE_KEY, JSON.stringify(data));
}

function loadState() {
  const saved = localStorage.getItem(STORAGE_KEY);
  if (!saved) return;
  
  const data = JSON.parse(saved);
  Object.keys(data).forEach(id => {
    Object.keys(data[id]).forEach(idx => {
      const val = data[id][idx];
      const input = document.querySelector(`input[data-id="${id}"][data-idx="${idx}"]`);
      if (input) {
        input.value = val;
        input.style.setProperty('--fill', (val / 10) * 100 + '%');
        const display = document.getElementById(`val-${id}-${idx}`);
        if (display) display.textContent = val;
      }
    });
  });
}

// 3. Event Handlers
function switchTab(index) {
  if (index < 0 || index >= stellingen.length) return;
  currentTab = index;
  document.querySelectorAll('.tab-btn').forEach((b,i) => b.classList.toggle('active', i===index));
  document.querySelectorAll('.panel').forEach((p,i) => p.classList.toggle('active', i===index));
  document.querySelectorAll('.progress-dot').forEach((d,i) => d.classList.toggle('active', i===index));
  tabsScroll.children[index].scrollIntoView({ behavior:'smooth', block:'nearest', inline:'center' });
}

function updateSlider(el, sid, si) {
  el.style.setProperty('--fill', (el.value/10)*100+'%');
  document.getElementById(`val-${sid}-${si}`).textContent = el.value;
  saveState(); // Sla direct op bij aanpassing
}

function resetSliders(sid, count) {
  const panel = document.getElementById(`panel-${sid}`);
  panel.querySelectorAll('input[type="range"]').forEach((s,i) => {
    s.value = 5; 
    s.style.setProperty('--fill','50%');
    document.getElementById(`val-${sid}-${i}`).textContent = '5';
  });
  saveState(); // Update opslag na reset
}

// 4. Start de app en laad opgeslagen data
document.addEventListener('DOMContentLoaded', loadState);

document.addEventListener('keydown', e => {
  if (e.key==='ArrowRight') switchTab(currentTab+1);
  if (e.key==='ArrowLeft') switchTab(currentTab-1);
});
</script>
